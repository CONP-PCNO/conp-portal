# -------------------------------------------------------------------
# FLASK SETTINGS
# -------------------------------------------------------------------
FLASK_APP=conp.py
FLASK_ENV=development
FLASK_DEBUG=0

## Flask and Flask-Security signing keys
## Should not be shorter than 32 bytes.
SECRET_KEY=you-will-never-guess
# Set to a generated value distinct from SECRET_KEY; keep it stable.
SECURITY_PASSWORD_SALT=

# -------------------------------------------------------------------
# DATABASE SETTINGS
# -------------------------------------------------------------------
# For MySQL, include ?charset=utf8mb4 at the end of the URL.
DATABASE_URL='sqlite:////path/to/conp-portal/app.db'
SQLALCHEMY_TRACK_MODIFICATIONS=False


# -------------------------------------------------------------------
# DATA SETTINGS
# -------------------------------------------------------------------
DATA_PATH=${HOME}
# DATASET_CACHE_PATH is the location where zipped datasets are kept.
DATASET_CACHE_PATH=${HOME}/.cache/conp-dataset

# -------------------------------------------------------------------
# MAIL SETTINGS
# -------------------------------------------------------------------
MAIL_SERVER=smtp.googlemail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME='your-gmail-username'
MAIL_PASSWORD='your-gmail-app-specific-password'
OAUTHLIB_INSECURE_TRANSPORT=1

# -------------------------------------------------------------------
# ORCID SETTINGS
# -------------------------------------------------------------------
USE_ORCID_OAUTH_SANDBOX=0
ORCID_OAUTH_CLIENT_ID=''
ORCID_OAUTH_CLIENT_SECRET=''
ORCID_TOKEN_URL=https://orcid.org/oauth/token

ADMIN_EMAIL=your-email@example.org
WEBHOOKS_SECRET='replace-with-github-webhook-secret'

# @todo: these are on the production server but not in repo flaskenv.template
#GIT_PYTHON_GIT_EXECUTABLE=/usr/bin/git
#GIT_PYTHON_REFRESH=quiet

# -------------------------------------------------------------------
# MATOMO SETTINGS
# -------------------------------------------------------------------
MATOMO_SERVER_URL=matomo.example.org # no http:// or https://
MATOMO_SITE_ID=your-matomo-site-id
MATOMO_TOKEN_AUTH='your-matomo-token'

# -------------------------------------------------------------------
# OPENALEX (for `flask update_research_use`; free key from https://openalex.org)
# -------------------------------------------------------------------
OPENALEX_API_KEY=

# -------------------------------------------------------------------
# GITHUB SETTINGS
# -------------------------------------------------------------------
# GITHUB CREDENTIALS FOR MARKDOWN RENDERER (OPTIONAL)
GITHUB_USER=
GITHUB_PAT=

# -------------------------------------------------------------------
# FOR ARK ID GENERATION
# -------------------------------------------------------------------
ARK_CONP_NAAN=99999 # FOR DEV INSTALLATION ALWAYS USE 99999
