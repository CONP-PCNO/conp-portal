# -------------------------------------------------------------------
# FLASK SETTINGS
# -------------------------------------------------------------------
FLASK_APP=conp.py
FLASK_ENV=development
FLASK_DEBUG=0

## Flask-User TokenManager
## Should not be shorter than 32 bytes.
SECRET_KEY=you-will-never-guess

# -------------------------------------------------------------------
# DATABASE SETTINGS
# -------------------------------------------------------------------
DATABASE_URL=sqlite:///<ENTER FLASK TOP DIR>/app.db
SQLALCHEMY_TRACK_MODIFICATIONS=False


# -------------------------------------------------------------------
# DATA SETTINGS
# -------------------------------------------------------------------
DATA_PATH=${HOME}
# DATASET_CACHE_PATH is the location where zipped datasets are kept.
DATASET_CACHE_PATH=${HOME}/.cache/conp-dataset

# -------------------------------------------------------------------
# MAIL SETTINGS
# -------------------------------------------------------------------
MAIL_SERVER=smtp.googlemail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=<Your gmail user name>
MAIL_PASSWORD=<Your gmail app specific password, not your normal one>
OAUTHLIB_INSECURE_TRANSPORT=1

# -------------------------------------------------------------------
# ORCID SETTINGS
# -------------------------------------------------------------------
USE_ORCID_OAUTH_SANDBOX=<1 if testing 0 if not>
ORCID_OAUTH_CLIENT_ID=<ORCID CLIENT ID>
ORCID_OAUTH_CLIENT_SECRET=<ORCID SECRET ID>
ORCID_TOKEN_URL=https://orcid.org/oauth/token

ADMIN_EMAIL = <Your gmail>
WEBHOOKS_SECRET=<github webhook secret>

# @todo: these are on the production server but not in repo flaskenv.template
#GIT_PYTHON_GIT_EXECUTABLE=/usr/bin/git
#GIT_PYTHON_REFRESH=quiet

# -------------------------------------------------------------------
# MATOMO SETTINGS
# -------------------------------------------------------------------
MATOMO_SERVER_URL=<Your Matomo base URL> ## no http:// or https://
MATOMO_SITE_ID=<Your Matomo site ID>
MATOMO_TOKEN_AUTH=<Your Matomo token auth>

# -------------------------------------------------------------------
# GITHUB SETTINGS
# -------------------------------------------------------------------
# GITHUB CREDENTIALS FOR MARKDOWN RENDERER (OPTIONAL)
GITHUB_USER=
GITHUB_PAT=

# -------------------------------------------------------------------
# FOR ARK ID GENERATION
# -------------------------------------------------------------------
ARK_CONP_NAAN=99999 # FOR DEV INSTALLATION ALWAYS USE 99999
